html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Press Start 2P','Courier New',monospace;-webkit-user-select:none;user-select:none;touch-action:manipulation}
#cab{width:100%;max-width:1200px;margin:0 auto;min-height:100vh;background:radial-gradient(ellipse at top,#241250,#0a0714 70%)}
header{display:flex;justify-content:space-between;align-items:center;padding:12px 4vw;background:#150b30;border-bottom:3px solid var(--mg);font-size:clamp(10px,1.4vw,14px);color:var(--cy);text-shadow:0 0 8px var(--cy)}
.sm{font:inherit;font-size:9px;padding:8px;background:none;color:#fff;border:2px solid #fff;cursor:pointer}
#ui{padding:20px 4vw 40px;font-size:clamp(9px,1.1vw,12px);line-height:2;max-width:1000px;margin:0 auto}
h1{font-size:clamp(18px,3.4vw,34px);line-height:1.5;color:var(--mg);text-shadow:3px 3px 0 #3a0f5a,0 0 16px var(--mg);margin:8px 0}
h2{font-size:clamp(12px,1.8vw,18px);color:var(--yl);margin:8px 0}
.dim{color:#a99ede}.warn{color:var(--rd)}.hd{display:flex;justify-content:space-between;color:var(--cy);gap:10px}
.btn{font:inherit;font-size:clamp(9px,1.1vw,12px);padding:13px;background:#2a1a5e;color:#fff;border:3px solid #fff;box-shadow:0 4px 0 #000;cursor:pointer;margin:4px 0}
.btn:active{transform:translateY(3px);box-shadow:none}.btn:disabled{opacity:.35;cursor:default}
.go{background:#128a3e}.big{width:100%;padding:18px;margin-top:12px}
.opt{display:block;width:100%;text-align:left;margin:8px 0;line-height:1.7}
.ok{background:#128a3e!important}.bad{background:#b3202f!important}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;margin:12px 0}
.card{border:2px solid #4b3a8f;padding:12px;background:#1a1038}
.card b{color:var(--yl)}.card i{font-style:normal;color:var(--cy)}
.row{display:flex;gap:10px;flex-wrap:wrap}
.pips{margin:8px 0}.pips s{display:inline-block;width:26px;height:11px;border:2px solid #5a4a9a;margin-right:5px}
.pips s.on{background:var(--gr);border-color:var(--gr)}.pips s.ul{border-color:var(--yl);animation:bl 1s steps(2) infinite}
.blink{animation:bl 1s steps(2) infinite;color:var(--yl);margin:16px 0}
@keyframes bl{50%{opacity:.25}}
@media (prefers-reduced-motion:reduce){.blink,.pips s.ul{animation:none}}
table{width:100%;border-collapse:collapse;margin:10px 0}td,th{padding:8px 4px;text-align:left;border-bottom:2px solid #3a2a78;font-weight:normal}
.me td{color:var(--yl)}
#ui>*{animation:up .35s ease-out both}
@keyframes up{from{opacity:0;transform:translateY(10px)}}
.hb{display:flex;gap:8px}.sm.arm{background:#b3202f;border-color:#ff4d5e}
.btn{transition:filter .15s,transform .15s}.btn:hover:not(:disabled){filter:brightness(1.2);transform:translateY(-2px)}
.card{transition:transform .2s}.card:hover{transform:translateY(-2px)}
.ic{width:100%;max-width:128px;aspect-ratio:2/1;image-rendering:pixelated;background:#0d0820;margin-bottom:6px}
#cs{position:relative;overflow:hidden;background:#0d0820;border:3px solid #4b3a8f;margin:22px 0;transition:box-shadow .5s,border-color .5s}
#cs::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#0a0714,transparent 22%,transparent 78%,#0a0714);pointer-events:none}
#pt{position:absolute;left:50%;top:0;bottom:0;width:3px;margin-left:-1px;background:var(--yl);z-index:2;box-shadow:0 0 14px var(--yl)}
#st{display:flex;will-change:transform;padding:10px 0}
.cl{flex:0 0 136px;margin:0 2px;padding:6px;background:#1a1038;border-bottom:4px solid;text-align:center;font-size:7px;line-height:1.6}
.cl canvas{width:100%;display:block;image-rendering:pixelated}
.pop{animation:pop .6s cubic-bezier(.2,1.6,.4,1) both,glow 1.4s ease-in-out .6s infinite alternate;text-align:center}
@keyframes pop{from{transform:scale(.4);opacity:0}}
@keyframes glow{to{box-shadow:0 0 30px var(--c)}}
@media (prefers-reduced-motion:reduce){#ui>*,.pop{animation:none}}
#cv{display:block;width:min(100%,calc(74vh*16/9));aspect-ratio:16/9;margin:0 auto;image-rendering:pixelated;background:#000}
#pads{display:flex;flex-wrap:wrap;gap:10px;padding:10px 4vw}
.pad{flex:1 1 300px;max-width:520px;margin:0 auto;display:flex;gap:6px}
.pad div{display:flex;gap:6px;flex:1}
.pad button{font:inherit;font-size:15px;flex:1;min-width:0;height:70px;background:#2a1a5e;color:#fff;border:3px solid #ff4d5e;border-radius:12px;touch-action:none}
.pad[data-p="2"] button{border-color:#b25cff}
.pad button.s{font-size:8px}.pad button:active{background:#5b3bd1}
@media (pointer:fine){#pads{display:none}}
#hint{text-align:center;font-size:8px;line-height:2;padding:6px 4vw}
