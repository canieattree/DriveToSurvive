function ans(j){if(Q.sel>=0)return;Q.sel=j;const p=S.p[S.cur],k=Q.c.k;p.tot++;
 if(Q.o[j]==1){p.right++;p.money+=100;p.unl[k]=Math.min(3,p.unl[k]+1);[523,659,784,1047].forEach((f,i)=>beep(f,.1,'square',.05,i*.07))}
 else{p.pen=Math.min(2,Math.round((p.pen+.2)*10)/10);beep(150,.2,'sawtooth',.07);beep(110,.35,'sawtooth',.07,.18)}
