 o.forEach((n,j)=>{const cl=sel<0?'':n==1?'ok':j==sel?'bad':'';h+=`<button class="btn opt ${cl}" ${sel>=0?'disabled':''} onclick="ans(${j})">${q[n]}</button>`});
