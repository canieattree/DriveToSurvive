 show(h+`</div><button class="btn go big" onclick="pitDone()">${S.mode==2?'DONE ▶':'START RACE ▶'}</button>`)}
function buy(k){const p=S.p[S.cur],o=p.own[k];if(p.money<COST[o]||p.unl[k]<=o)return;p.money-=COST[o];p.own[k]++;[392,523,784].forEach((f,i)=>beep(f,.1,'square',.05,i*.07));garage()}

let Q;
function ask(k){const c=CATS.find(x=>x.k==k),p=S.p[S.cur];let u=p.used[k];if(u.length>=c.pool.length)u=p.used[k]=[];
 let i;do i=Math.random()*c.pool.length|0;while(u.includes(i));u.push(i);
