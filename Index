 const cars=[0,1,2,3].map(i=>{const pn=i==3?1:i==2&&m==2?2:0,sl=qpn?0:S.grid.indexOf(i),idx=N-4-sl*5,t=T.T[idx],o=sl%2?8:-8;
  const c={id:i,pn,name:pn?(m==2?'P'+pn:'YOU'):an[i],col:pn?(pn==1?'#ff3b4e':'#b25cff'):cl[i],idx,wraps:0,fin:0,d:0,v:0,off:o,boostT:0,warn:0,out:0,slow:0,mt:0,msg:'',
   x:T.C[idx][0]-t[1]*o,y:T.C[idx][1]+t[0]*o,a:Math.atan2(t[1],t[0]),max:aiMax+[6,0,-6,0][i]+Math.random()*4};
  if(pn){const p=S.p[pn-1],L=p.own;Object.assign(c,{skin:pn==1?SV.skin:'s_std',fx:pn==1?SV.fx:'f_fl',max:80+L.eng*14,acc:70+L.eng*18,hl:L.han,bl:1.2+.5*L.ecu,boost:1+L.tur,pen:qpn?0:p.pen});if(!qpn)p.pen=0}
  return c}).filter(c=>!qpn||c.pn==qpn);
 if(!qpn)S.names=cars.map(c=>c.name);
 R={T,cars,pt:[],pc:0,q:qpn,laps:qpn?1:LAPS,hum:cars.filter(c=>c.pn),t:-3,time:0,order:[],mode:0,cd:9,go:0,on:1,nf:0};
 $('#ui').hidden=true;$('#race').hidden=false;$('#pad2').hidden=m!=2;document.activeElement.blur();
 [1,2].forEach(n=>{K[n].l=K[n].r=K[n].b=P[n].l=P[n].r=P[n].b=0});setB();
 $('#hint').textContent=m==2?'P1: A/D STEER · S BRAKE · W BOOST      P2: ←/→ STEER · ↓ BRAKE · ↑ BOOST':'ARROWS OR A/D STEER · ↓ OR S BRAKE · SPACE OR ↑ BOOST';
 let last=performance.now();
 const loop=ts=>{if(!R||!R.on)return;const dt=Math.min(.05,(ts-last)/1000||0);last=ts;update(dt);draw();requestAnimationFrame(loop)};
 requestAnimationFrame(loop)}
const key=c=>c.fin?1e6-c.fin:c.wraps*R.T.N+c.idx;
function setB(){R.hum.forEach(c=>{const b=$('#b'+c.pn);if(b)b.textContent='BOOST x'+c.boost})}
function boost(n){const c=R&&R.on&&R.time>=0&&R.cars.find(x=>x.pn==n&&!x.auto);if(c&&c.boost>0&&c.boostT<=0){c.boost--;c.boostT=c.bl*SC;setB();beep(260,.35,'sawtooth',.06)}}

function step(c,dt){
 const T=R.T,C=T.C,N=T.N,pl=c.pn&&!c.auto,hold=pl&&R.time<c.pen;
 let st=0,br=0,mx,turn;
 if(pl){const k=K[c.pn],p=P[c.pn];st=(k.r|p.r)-(k.l|p.l);br=k.b|p.b;turn=2.5+c.hl*.35;mx=c.max}
 else{const j=(c.idx+9)%N,q=C[j],n=T.T[j],tx=q[0]-n[1]*c.off,ty=q[1]+n[0]*c.off,da=ad(Math.atan2(ty-c.y,tx-c.x),c.a);
  st=clamp(da*3,-1,1);turn=3.4;mx=c.max*(1-Math.min(.3,Math.abs(da)*.45));
  const h=R.hum[0],d=(key(c)-key(h))/N;if(!h.fin){if(d>.3)mx*=.9;else if(d<-.3)mx*=1.06}}
 if(c.boostT>0){c.boostT-=dt;mx*=1.4}
 if(c.d>HW+2)mx*=c.pn?.55+.05*c.hl:.8;
 if(c.slow>0){c.slow-=dt;mx*=.3}
 if(hold){c.v=0}else{
  if(c.v<mx)c.v+=(c.acc||90)*dt*(c.boostT>0?2.2:1);else c.v-=(c.slow>0?220:70)*dt;
  if(br)c.v-=170*dt;
  c.v=Math.max(0,c.v*(1-Math.abs(st)*.2*dt));
  c.a+=st*turn*(.35+.65*Math.min(1,c.v/60))*dt;
  c.x=clamp(c.x+Math.cos(c.a)*c.v*dt,4,W-4);c.y=clamp(c.y+Math.sin(c.a)*c.v*dt,4,H-4)}
 const old=c.idx;let b=1e9,bi=old;
 for(let k=-8;k<=25;k++){const i=(old+k+N)%N,d=(C[i][0]-c.x)**2+(C[i][1]-c.y)**2;if(d<b){b=d;bi=i}}
 c.d=Math.sqrt(b);c.idx=bi;
 if(c.d>HW+7.5){const q=C[bi],k=(HW+7.5)/c.d;c.x=q[0]+(c.x-q[0])*k;c.y=q[1]+(c.y-q[1])*k;if(c.v>30)c.hit=1;c.v*=.85;c.d=HW+7.5}
 if(c.pn){const out=c.d>HW+3.5;
  if(out&&!c.out){c.out=1;c.warn++;c.mt=100;c.msg=c.warn>3?'HEAVY SLOWDOWN!':'TRACK LIMITS '+c.warn+'/3';beep(c.warn>3?110:220,.2,'square',.06);if(c.warn>3)c.slow=4*SC}
  else if(!out)c.out=0}
 if(old>N*.75&&bi<N*.25){c.wraps++;if(c.wraps==1)c.t0=R.time}else if(old<N*.25&&bi>N*.75)c.wraps--;
 if(c.wraps>R.laps&&!c.fin){c.fin=R.time;R.order.push(c);
  if(c.pn){c.auto=1;c.off=0;c.max=95;c.slow=0;if(++R.nf==R.hum.length){R.mode=1;R.end=R.time+1.6}[523,659,784,1047].forEach((f,i)=>beep(f,.12,'square',.05,i*.1))}}}

function update(dt){
 R.t+=dt;
 if(R.t<0){const cd=Math.ceil(-R.t);if(cd!==R.cd){R.cd=cd;beep(440,.15)}return}
 if(!R.go){R.go=1;beep(880,.45)}
 R.time=R.t;R.cars.forEach(c=>{step(c,dt*SC);fxs(c)});R.pt=R.pt.filter(p=>{p.l-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;return p.l>0});
 const nc=R.cars.length;for(let i=0;i<nc;i++)for(let j=i+1;j<nc;j++){const a=R.cars[i],b=R.cars[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy);
  if(d<11&&d>0){const o=(11-d)/2,nx=dx/d,ny=dy/d;a.x-=nx*o;a.y-=ny*o;b.x+=nx*o;b.y+=ny*o;a.v*=.985;b.v*=.985}}
 if(R.mode==1&&R.time>R.end){R.on=0;finishRace()}}

