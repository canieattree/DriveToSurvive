 let rr=Math.random()*100,ri=0;while(ri<3&&rr>=RAR[ri][3]){rr-=RAR[ri][3];ri++}
 const CI=ITEMS.filter(i=>i.cs),pool=CI.filter(i=>i.r==ri),win=pool[Math.random()*pool.length|0],cells=[...Array(50)].map((_,i)=>i==40?win:CI[Math.random()*CI.length|0]);
 show(`<div class="hd"><span>OPENING CASE...</span><span>🪙 ${SV.coins}</span></div><div id="cs"><div id="pt"></div><div id="st">${cells.map(it=>`<div class="cl" style="border-color:${RAR[it.r][1]}"><canvas data-i="${it.id}" width="128" height="64"></canvas>${it.n}</div>`).join('')}</div></div><div id="rv"></div>`);
 const dup=SV.own.includes(win.id);if(dup)SV.coins+=60;else SV.own.push(win.id);save();
 document.querySelectorAll('#st canvas').forEach(c=>icon(ITEMS.find(i=>i.id==c.dataset.i),c));
 const st=$('#st'),cs=$('#cs'),cw=140,half=cs.clientWidth/2,tg=40*cw+cw/2+(Math.random()-.5)*cw*.6-half,t0=performance.now();let last=-1;
 const reveal=()=>{const r=RAR[win.r];
  cs.style.borderColor=r[1];cs.style.boxShadow=`0 0 30px ${r[1]}`;[523,659,784,1047,1319].slice(0,win.r+3).forEach((f,i)=>beep(f,.15,'square',.05,i*.09));
  $('#rv').innerHTML=`<div class="card pop" style="--c:${r[1]};border-color:${r[1]}"><canvas class="ic" id="wc" width="128" height="64"></canvas><br><b style="color:${r[1]}">${r[0]}</b><br><b>${win.n}</b><br><span class="dim">${win.d}</span><br>${dup?'<span class="warn">DUPLICATE · +60 COINS</span>':'<span style="color:var(--gr)">NEW ITEM!</span>'}</div><div class="row">${dup?'':`<button class="btn go" onclick="equip('${win.id}')">EQUIP IT</button>`}<button class="btn" ${SV.coins<150?'disabled':''} onclick="openCase()">OPEN ANOTHER · 150</button><button class="btn" onclick="store()">BACK TO STORE</button></div>`;icon(win,$('#wc'))};
 const fr=now=>{if(!st.isConnected)return;const t=Math.min(1,(now-t0)/6500),pos=tg*(1-Math.pow(1-t,4)),ci=Math.floor((pos+half)/cw);
  st.style.transform=`translateX(${-pos}px)`;if(ci!==last){last=ci;beep(600+ci%3*80,.03,'square',.03)}
  if(t<1)requestAnimationFrame(fr);else reveal()};
 requestAnimationFrame(fr)}
const nm=id=>id==3?(S.mode==2?'P1':'YOU'):id==2&&S.mode==2?'P2':['VOLT-A','OHM-ER','WATT-S'][id];
function qual(){S.qt={};S.qi=0;S.ql='';qnext()}
function qnext(){if(S.qi>=S.mode)return grid();const pn=S.qi+1;
 show(`<h2>QUALIFYING</h2><h1 style="font-size:clamp(16px,2.6vw,26px)">${S.mode==2?'PLAYER '+pn:'YOUR LAP'}</h1>${S.ql}<p>One flying lap, alone on the track. The fastest time starts on pole.<br>${TRACKS[S.race].n}</p><button class="btn go big" onclick="startRace(${pn})">GO ▶</button>`)}
function qdone(){const c=R.cars[0],t=c.fin-(c.t0||0);S.qt[c.pn]=t;S.ql=`<p style="color:var(--gr)">${nm(c.id)} LAP: ${t.toFixed(2)}s</p>`;S.qi++;qnext()}
function grid(){const T=TRACKS[S.race],rows=[0,1,2,3].map(i=>{const pn=i==3?1:i==2&&S.mode==2?2:0;return[i,pn?S.qt[pn]:T.len/((70+S.race*9+[6,0,-6,0][i]+Math.random()*4)*SC*.86)+.3+Math.random()*.6]}).sort((a,b)=>a[1]-b[1]);
 S.grid=rows.map(r=>r[0]);
 let h=`<h2>STARTING GRID</h2><h1 style="font-size:clamp(16px,2.6vw,26px)">${T.n}</h1><table><tr class="dim"><th>GRID</th><th>DRIVER</th><th>QUALI LAP</th></tr>`;
 rows.forEach((r,k)=>h+=`<tr class="${r[0]>(S.mode==2?1:2)?'me':''}"><td>${k==0?'POLE':k+1}</td><td>${nm(r[0])}</td><td>${r[1].toFixed(2)}s</td></tr>`);
 show(h+`</table><button class="btn go big" onclick="startRace()">START RACE ▶</button>`)}
function drawAnim(t,tm){
 if(t.e==0){g.fillStyle='#bfe6ff';t.sp.forEach(s=>{g.globalAlpha=.25+.35*Math.sin(tm*2+s[2]);g.fillRect(s[0],s[1],5,1)});g.globalAlpha=1;
  t.bt.forEach(o=>{const w=tm*o.sp/o.L*3.1416+o.ph,u=(Math.sin(w)+1)/2,h=o.an+(Math.cos(w)>0?0:3.1416),x=o.a+Math.cos(o.an)*o.L*u,y=o.b+Math.sin(o.an)*o.L*u;
   for(let i=1;i<5;i++){g.fillStyle=`rgba(255,255,255,${.5-i*.1})`;g.fillRect(x-Math.cos(h)*i*6,y-Math.sin(h)*i*6,3,2)}
   g.save();g.translate(x,y);g.rotate(h);g.fillStyle='#fff';g.beginPath();g.ellipse(0,0,11,4,0,0,7);g.fill();g.fillStyle=o.c;g.fillRect(-3,-2,6,4);g.restore()})}
 if(t.e==1)t.ld.forEach(l=>{g.fillStyle=Math.sin(tm*3+l[2])>0?'#ff4d5e':'#552';g.fillRect(l[0],l[1],2,2)});
 if(t.e==2)t.tr.forEach((r,k)=>{const p=(tm*45+k*53)%(r[2]+30),hz=r[3];g.fillStyle=Math.sin(tm*2+k)>.3?'#ff5a5a':'#5a1a1a';g.fillRect(r[0]-1,r[1]-1,3,3);
  if(p<=r[2]){const x=hz?r[0]+p:r[0],y=hz?r[1]:r[1]+p;g.fillStyle='#9dffb8';g.fillRect(x-1,y-1,3,3);g.globalAlpha=.4;g.fillRect(hz?x-7:x-1,hz?y-1:y-7,hz?6:3,hz?3:6);g.globalAlpha=1}})}
function drawSky(t,tm){if(t.e==2)return;g.fillStyle='rgba(0,0,0,.14)';
 for(let k=0;k<3;k++){g.beginPath();g.ellipse((tm*9+k*260)%(W+240)-120,70+k*110+Math.sin(tm*.3+k)*18,70,26,0,0,7);g.fill()}
 if(t.e==1){const x=W/2+Math.cos(tm*.25)*230,y=H/2+Math.sin(tm*.37)*110,a=tm*30;g.fillStyle='rgba(0,0,0,.25)';g.fillRect(x+10,y+14,16,6);g.fillStyle='#e8ecf4';g.fillRect(x-8,y-3,16,7);g.fillStyle='#e0524e';g.fillRect(x+8,y-1,10,2);
  g.strokeStyle='#222';g.lineWidth=1.5;g.beginPath();g.moveTo(x-Math.cos(a)*16,y-Math.sin(a)*16);g.lineTo(x+Math.cos(a)*16,y+Math.sin(a)*16);g.stroke()}}
function txt(s,x,y,sz,col,al='center'){g.font=sz*1.4+'px "Press Start 2P",monospace';g.textAlign=al;g.fillStyle=col;g.fillText(s,x,y)}
function drawCar(c){g.save();g.translate(c.x,c.y);g.rotate(c.a);g.scale(1.3,1.3);
 g.fillStyle='rgba(0,0,0,.3)';g.fillRect(-5,-2,12,7);
 if(c.boostT>0){g.fillStyle='rgba(255,255,255,.25)';g.fillRect(-8,-5,16,10)}
 if(c.slow>0){g.fillStyle='#888';g.fillRect(-9,-3,3,2);g.fillRect(-12,1,3,2)}
 g.fillStyle='#111';[[-5,-4],[-5,3],[3,-4],[3,3]].forEach(w=>g.fillRect(w[0],w[1],3,2));
 paintSkin(c.skin,c.col,g);
 g.fillStyle='#bfeaff';g.fillRect(0,-2,3,4);g.fillStyle='#222';g.fillRect(5,-2,1,4);g.restore()}
function draw(){
 g.drawImage(R.T.bg,0,0);drawAnim(R.T,performance.now()/1000);R.pt.forEach(p=>{g.globalAlpha=Math.max(0,p.l/p.m);if(p.ch)txt(p.ch,p.x,p.y,p.s,p.c);else{g.fillStyle=p.c;g.fillRect(p.x,p.y,p.s,p.s)}});g.globalAlpha=1;
 [...R.cars].sort((a,b)=>a.y-b.y).forEach(drawCar);const tm=performance.now()/1000;drawSky(R.T,tm);
 if(R.time<1.8&&Math.floor(tm*5)%2)R.hum.forEach(c=>{g.fillStyle=c.pn==1?'#e0243a':'#8a3fd8';g.fillRect(c.x-17,c.y-36,34,17);g.beginPath();g.moveTo(c.x-6,c.y-19);g.lineTo(c.x+6,c.y-19);g.lineTo(c.x,c.y-12);g.fill();txt('P'+c.pn,c.x,c.y-23,8,'#fff')});
 g.fillStyle='rgba(0,0,0,.65)';g.fillRect(0,0,W,6+R.hum.length*15);
 R.hum.forEach((c,i)=>{const pos=1+R.cars.filter(o=>key(o)>key(c)).length;
  txt(`${c.name} LAP ${clamp(c.wraps,1,R.laps)}/${R.laps} ${R.q?'QUALI':'POS '+pos+'/4'} TL ${Math.min(c.warn,3)}/3`,4,12+i*15,8,c.warn>3?'#ff4d5e':c.warn?'#ffb020':'#fff','left')});
 txt(fmt(R.time),W-4,12,8,'#fff','right');
 R.hum.forEach((c,i)=>{if(c.mt>0){c.mt--;g.globalAlpha=Math.min(1,c.mt/25);txt(c.msg,W/2,48+i*14-(100-c.mt)/20,9,c.warn>3?'#ff4d5e':'#ffb020');g.globalAlpha=1}});
 if(R.t<0){const n=Math.ceil(-R.t);for(let i=0;i<3;i++){g.fillStyle=i<4-n?'#ff2a2a':'#401010';g.beginPath();g.arc(W/2-24+i*24,100,9,0,7);g.fill()}txt('GET READY',W/2,128,10,'#ffe14d')}
 else if(R.time<.9){g.globalAlpha=Math.min(1,(.9-R.time)*3);txt('GO!',W/2,H/2,28+R.time*40,'#5dff7a');g.globalAlpha=1}
 R.hum.forEach((c,i)=>{if(R.mode==0&&R.time<c.pen)txt(c.name+' PENALTY HOLD '+(c.pen-R.time).toFixed(1)+'s',W/2,H/2+16+i*12,8,'#ff4d5e')});
 if(R.mode==1)txt('FINISH!',W/2,H/2,24,'#ffe14d')}

function finishRace(){if(R.q)return qdone();
 const rest=R.cars.filter(c=>!R.order.includes(c)).sort((a,b)=>key(b)-key(a)),fin=[...R.order,...rest];
 fin.forEach((c,r)=>S.pts[c.id]+=PTS[r]);
 let h=`<h2>${TRACKS[S.race].n}</h2><h1 style="font-size:clamp(16px,2.6vw,26px)">RACE RESULT</h1>`;
 fin.forEach((c,r)=>{if(c.pn){h+=`<p>${c.name}: ${['1ST','2ND','3RD','4TH'][r]} · TIME ${fmt(c.fin)}${c.warn?` · ${c.warn} WARNINGS`:''}</p>`}});
 const bp=fin.findIndex(c=>c.pn),cn=[60,35,20,10][bp];SV.coins+=cn;SV.races++;if(bp==0)SV.wins++;save();h+=`<p style="color:var(--yl)">🪙 +${cn} COINS ADDED TO YOUR INVENTORY (${SV.coins} TOTAL)</p>`;
 h+=`<table><tr class="dim"><th>POS</th><th>DRIVER</th><th>+PTS</th><th>TOTAL</th></tr>`;
 fin.forEach((c,r)=>h+=`<tr class="${c.pn?'me':''}"><td>${r+1}</td><td>${c.name}</td><td>+${PTS[r]}</td><td>${S.pts[c.id]}</td></tr>`);
 show(h+`</table>`+(S.race<2?`<button class="btn go big" onclick="S.race++;pit()">TO THE PIT LAB ▶</button>`:`<button class="btn go big" onclick="final()">FINAL RESULTS ▶</button>`))}

function final(){
 const m=S.mode,rows=S.pts.map((p,i)=>[S.names[i],p,i]).sort((a,b)=>b[1]-a[1]),w=rows[0],hw=m==2?w[2]>1:w[2]==3;
 if(m==1&&S.pts[3]>SV.best)SV.best=S.pts[3];if(hw){SV.coins+=100;SV.champ++}save();
 let h=`<h1>${hw?(m==2?w[0]+' WINS!':'🏆 CHAMPION!'):'GAME OVER'}</h1><p>${hw?'Great racing and great electronics knowledge! +100 COIN BONUS!':'The AI took the title. Upgrade smarter and try again!'}</p><table><tr class="dim"><th>POS</th><th>DRIVER</th><th>POINTS</th></tr>`;
 rows.forEach((r,i)=>h+=`<tr class="${r[2]>(m==2?1:2)?'me':''}"><td>${i+1}</td><td>${r[0]}</td><td>${r[1]}</td></tr>`);
 h+=`</table><div class="card"><b>QUIZ SCORES</b><br>${S.p.slice(0,m).map((p,i)=>`${m==2?'P'+(i+1):'YOU'}: ${p.right} / ${p.tot} correct`).join('<br>')}</div><button class="btn go big" onclick="newGame(S.mode);pit()">PLAY AGAIN</button><button class="btn big" style="background:#b8860b" onclick="store()">STORE · 🪙 ${SV.coins}</button><button class="btn big" onclick="title()">TITLE SCREEN</button>`;
 [523,659,784,1047].forEach((f,i)=>beep(f,.15,'square',.05,i*.12));show(h)}

/* input */
const AR={arrowleft:'l',arrowright:'r',arrowdown:'b',arrowup:'n'},WA={a:'l',d:'r',s:'b',w:'n',' ':'n'};
function KB(e){const k=e.key.toLowerCase();if(WA[k])return[1,WA[k]];if(AR[k])return[S.mode==2?2:1,AR[k]];return null}
addEventListener('keydown',e=>{if(!R||!R.on)return;const m=KB(e);if(!m)return;e.preventDefault();if(m[1]=='n'){if(!e.repeat)boost(m[0])}else K[m[0]][m[1]]=1});
addEventListener('keyup',e=>{const m=R&&KB(e);if(m&&m[1]!='n')K[m[0]][m[1]]=0});
document.querySelectorAll('#pads button').forEach(b=>{const k=b.dataset.k,n=+b.dataset.p;
 b.addEventListener('pointerdown',e=>{e.preventDefault();k=='n'?boost(n):P[n][k]=1});
 ['pointerup','pointerleave','pointercancel'].forEach(v=>b.addEventListener(v,()=>{if(k!='n')P[n][k]=0}));
 b.addEventListener('contextmenu',e=>e.preventDefault())});
let exT;function disarm(){clearTimeout(exT);const b=$('#ex');b.classList.remove('arm');b.textContent='✕ MENU'}
$('#ex').onclick=e=>{const b=e.currentTarget;if(b.classList.contains('arm')){disarm();title()}else{b.classList.add('arm');b.textContent='TAP AGAIN TO EXIT';exT=setTimeout(disarm,2500)}b.blur()};
addEventListener('keydown',e=>{if(e.key=='Escape'&&!$('#ex').hidden)$('#ex').click()});
title();
