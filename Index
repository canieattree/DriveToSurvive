 const N=C.length;t.C=C;t.N=N;t.tr=[];t.bt=[];t.sp=[];t.ld=[];t.len=C.reduce((a,p,i)=>a+Math.hypot(p[0]-C[(i+1)%N][0],p[1]-C[(i+1)%N][1]),0);
